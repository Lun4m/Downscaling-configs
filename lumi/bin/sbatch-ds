#!/usr/bin/env python3
from __future__ import annotations

import argparse
import logging
import subprocess
import sys
from collections import defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

LOG = logging.getLogger(__name__)

_type_from_str = {"False": False, "True": True, "None": None}
_allowed_argparse_kwargs = ["default", "help", "required"]


def _find_root(path: Path) -> Path:
    """
    Finds the root folder from a slurm script path.

    Parameters
    ----------
    path : Path
        The path of the slurm script

    Returns
    -------
    Path
        The root folder of caerra-tu-ml
    """
    path = path.resolve()
    if path.is_file():
        return _find_root(path.parent)
    if (path / "bin" / "sbatch-ds").exists():
        return path
    if path.parent == path:
        raise ValueError("The slurm script is not in the caerra-tu-ml  project.")
    return _find_root(path.parent)


@dataclass
class Param:
    name_or_flags: list[str] = field(default_factory=list)
    kwargs: dict[str, Any] = field(default_factory=dict)


def validate_config_params(params: list[str]) -> list[Param]:
    new_params: list[Param] = []
    for param in params:
        param_args = param.split(",")
        name_or_flags: list[str] = []
        kwargs: dict[str, Any] = {}
        for arg in param_args:
            arg = arg.strip()
            if "=" not in arg:
                if len(kwargs) > 0:
                    raise ValueError(
                        "--param unamed arguments must be at the start of line."
                    )
                name_or_flags.append(arg)
            else:
                arg_name, _, arg_val = arg.partition("=")
                if arg_name not in _allowed_argparse_kwargs:
                    raise ValueError(
                        f"{arg_name} is not an allowed option for --param. "
                        f"Allowed: {', '.join(_allowed_argparse_kwargs)}."
                    )
                if arg_val[0] == arg_val[-1] == '"':
                    kwargs[arg_name] = arg_val[1:-1]
                else:
                    kwargs[arg_name] = _type_from_str.get(arg_val, arg_val)
        new_params.append(Param(name_or_flags=name_or_flags, kwargs=kwargs))
    return new_params


@dataclass
class Config:
    """
    Represent the config passed through the #SBATCHDS directives
    """

    wrapper: str | None = None
    """ Which wrapper to use. Defaults to ``default.env``. """
    params: list[Param] = field(default_factory=list)
    """
    Additional parameters for the sbatch-ds command to be passed to the scheduled job.
    """

    @classmethod
    def validate(cls, data: Any) -> Config:
        """
        Validate and formats the input data and returns the Config object.

        Parameters
        ----------
        data : Any
            The data to validate

        Returns
        -------
        Config
        """
        if isinstance(data, dict) and "param" in data:
            data["params"] = data.pop("param")

        if "wrapper" in data and len(data["wrapper"]):
            data["wrapper"] = data["wrapper"][-1]

        if "params" in data:
            data["params"] = validate_config_params(data["params"])

        return Config(**data)


class SlurmScript:
    """
    Represents the slurm script
    """

    def __init__(self, script: str) -> None:
        """
        Parses the slurm script content and extracts several parts.

        Parameters
        ----------
        script : str
            The slurm script.
        """
        pre_content: list[str] = []
        config: defaultdict[str, list[str]] = defaultdict(list)
        sbatch_config: list[str] = []
        post_content: list[str] = []
        lines = script.split("\n")
        for line in lines:
            line = line.strip()
            if line[:9] == "#SBATCHDS":
                param, _, value = line.strip()[10:].partition("=")
                config[param.replace("--", "")].append(value)
            elif line[:7] == "#SBATCH":
                sbatch_config.append(line)
            elif len(config) + len(sbatch_config) + len(post_content) == 0:
                pre_content.append(line)
            else:
                post_content.append(line)

        # Content before the #SBATCH directives
        self.pre_content = "\n".join(pre_content)
        # Config obtained from the #SBATCHDS directives
        self.config = Config.validate(config)
        # All #SBATCH directives. Possibly some comments
        self.sbatch_config = "\n".join(sbatch_config)
        # Content after the #SBATCH directives (the script)
        self.post_content = "\n".join(post_content)

    def add_pre_content(self, text: str) -> None:
        """
        Add content at the beginning of the script

        Parameters
        ----------
        text : str
            text to add
        """
        self.post_content = text + "\n" + self.post_content

    def get_content(self, wrapper_path: Path) -> str:
        """
        Get final script content

        Parameters
        ----------
        wrapper_path : Path
            path to wrapper to use

        Returns
        -------
        str
            the content
        """
        return "\n".join(
            [
                f"#!{str(wrapper_path.resolve())}",
                self.sbatch_config,
                self.post_content,
            ]
        )


def parse_extracted_params(
    params: list[Param], args: list[str]
) -> tuple[argparse.Namespace, list[str]]:
    """
    Extract args in a argv form with a description listin the format name:default


    Parameters
    ----------
    params : list[Param]
        list of params
    args : list[str]
        argv

    Returns
    -------
    tuple[argparse.Namespace, list[str]]
        * the parsed args
        * the leftover args in argv
    """
    parser = argparse.ArgumentParser(
        description="Arguments defined by the slurm script."
    )
    for param in params:
        parser.add_argument(*param.name_or_flags, **param.kwargs)
    parsed_args, rest = parser.parse_known_args(args)
    return parsed_args, rest


def main():
    parser = argparse.ArgumentParser(description="Launch slurm job")
    parser.add_argument(
        "path", nargs="?", default=None, type=Path, help="Path to the slurm job"
    )
    parser.add_argument(
        "--wrapper",
        type=str,
        default=None,
        help="Which environment wrapper to use.",
    )
    parser.add_argument(
        "--log-level",
        type=str,
        choices=logging.getLevelNamesMapping(),
        default="NOTSET",
        help="Log level",
    )
    args, sbatch_args = parser.parse_known_args()

    if args.log_level is not None:
        LOG.setLevel(args.log_level)

    if args.path is None and not sys.stdin.isatty():
        content = sys.stdin.read()
        root_folder = _find_root(Path.cwd())
    elif args.path is not None:
        job_path = Path(args.path).resolve()
        content = job_path.read_text()
        root_folder = _find_root(args.path)
    else:
        raise ValueError("a slurm script should be provided.")

    script = SlurmScript(content)
    env_wrapper = "default.env"
    if args.wrapper is not None:
        env_wrapper = args.wrapper
    elif script.config.wrapper is not None:
        env_wrapper = script.config.wrapper
    LOG.info("Using %s wrapper", env_wrapper)

    env_path = (root_folder / "hpc_configs" / "wrappers" / env_wrapper).resolve()
    if not env_path.exists():
        raise ValueError(f"{env_wrapper} is not a valid environment.")

    if len(script.config.params):
        job_args, sbatch_args = parse_extracted_params(
            script.config.params, sbatch_args
        )
        exports: list[str] = []
        for arg, val in vars(job_args).items():
            exports.append(f'export SBATCHDS_PARAM_{arg}="{val}"')
        script.add_pre_content("\n".join(exports))

    content = script.get_content(env_path)
    cmd = ["sbatch", *sbatch_args]
    process = subprocess.Popen(
        cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    (out, err) = process.communicate(bytes(script.get_content(env_path), "utf-8"))

    out_s, err_s = out.decode(), err.decode()
    if len(out_s):
        print(out_s, end="")
    if len(err_s):
        print(err_s, file=sys.stderr, end="")


if __name__ == "__main__":
    main()

